# Brevo (Sendinblue) — nécessaire pour inscriptions réelles
# Clé API: https://app.brevo.com/settings/keys/smtp (ou API keys)
BREVO_API_KEY=your_brevo_api_key
# (Optionnel) ID de la liste: si vous avez déjà créé une liste, mettez son ID numérique ici
# Contacts > Listes > sélectionner la liste > copier l’ID
BREVO_LIST_ID=

# (Optionnel) Envoi d’email de remerciement via Brevo Transactional
# Adresse email expéditrice validée dans Brevo
BREVO_SENDER_EMAIL=
# Nom expéditeur (facultatif)
BREVO_SENDER_NAME=La Déguste
# Template ID si vous utilisez un modèle Brevo (numérique). Sinon, un HTML simple sera envoyé.
BREVO_THANKS_TEMPLATE_ID=
